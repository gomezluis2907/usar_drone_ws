          <material><ambient>0.44 0.42 0.39 1</ambient><diffuse>0.52 0.49 0.46 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- Leaning survival-void concrete panel near victim_3 -->
        <collision name="b_leaning_panel_col"><pose>13.0 -8.2 1.6 -0.62 0 0.12</pose><geometry><box><size>7.0 0.32 4.2</size></box></geometry></collision>
        <visual name="b_leaning_panel_vis">
          <pose>13.0 -8.2 1.6 -0.62 0 0.12</pose><geometry><box><size>7.0 0.32 4.2</size></box></geometry>
