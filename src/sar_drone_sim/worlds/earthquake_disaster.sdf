          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>301.15</temperature></plugin>
        </visual>
      </link>
    </model>

    <!-- Smoldering electrical/fire hotspot: ~75C (above human 41.5C) -->
    <model name="thermal_hotspot_fire">
      <static>true</static>
      <pose>17.5 2.5 0.15 0 0 0.3</pose>
      <link name="hotspot_link">
        <collision name="hotspot_col"><geometry><box><size>0.55 0.55 0.30</size></box></geometry></collision>
        <visual name="hotspot_vis">
          <geometry><box><size>0.55 0.55 0.30</size></box></geometry>
          <material>
            <ambient>0.9 0.25 0.05 1</ambient>
            <diffuse>0.95 0.35 0.05 1</diffuse>
            <emissive>0.85 0.25 0.02 1</emissive>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>348.15</temperature></plugin>
        </visual>
      </link>
    </model>

