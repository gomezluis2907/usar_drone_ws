          <material><ambient>0.44 0.42 0.39 1</ambient><diffuse>0.52 0.49 0.46 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>290.65</temperature></plugin>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         THERMAL DISTRACTORS (Cooling Car + Electrical/Fire Hotspot)
         ================================================================ -->
    <!-- Damaged overturned car: chassis ~19C, cooling hood ~28C (below human 32.5C) -->
    <model name="damaged_car">
      <static>true</static>
      <pose>13.5 -1.5 0.65 0.22 0.08 -0.65</pose>
      <link name="car_link">
        <collision name="car_col"><geometry><box><size>4.0 1.75 1.1</size></box></geometry></collision>
