<?xml version="1.0"?>
<sdf version="1.9">
  <world name="earthquake_disaster">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.43 0.40 1</ambient>
      <background>0.55 0.58 0.62 1</background>
      <shadows>true</shadows>
    </scene>

    <atmosphere type="adiabatic">
      <temperature>291.15</temperature>
      <temperature_gradient>-0.0065</temperature_gradient>
    </atmosphere>

    <light type="directional" name="post_quake_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 25 0 0 0</pose>
      <diffuse>0.85 0.80 0.72 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <!-- Ground plane modeled as a solid box (required for Ogre2 thermal sensor accuracy) -->
    <model name="disaster_ground">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>120 120 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box>
              <size>120 120 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.26 0.26 0.25 1</ambient>
            <diffuse>0.32 0.31 0.29 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>290.15</temperature>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- Central Takeoff Helipad at (0, 0) -->
    <model name="takeoff_helipad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_collision">
          <geometry>
            <box>
              <size>2.6 2.6 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="pad_base">
          <geometry>
            <box>
              <size>2.6 2.6 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.19 0.21 1</ambient>
            <diffuse>0.22 0.23 0.26 1</diffuse>
          </material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
            <temperature>290.65</temperature>
          </plugin>
        </visual>
        <visual name="pad_ring_n">
          <pose>1.15 0 0.006 0 0 0</pose>
          <geometry><box><size>0.12 2.42 0.002</size></box></geometry>
          <material><ambient>0.9 0.7 0.05 1</ambient><diffuse>0.95 0.75 0.05 1</diffuse></material>
        </visual>
        <visual name="pad_ring_s">
          <pose>-1.15 0 0.006 0 0 0</pose>
          <geometry><box><size>0.12 2.42 0.002</size></box></geometry>
          <material><ambient>0.9 0.7 0.05 1</ambient><diffuse>0.95 0.75 0.05 1</diffuse></material>
        </visual>
        <visual name="pad_ring_e">
          <pose>0 1.15 0.006 0 0 0</pose>
          <geometry><box><size>2.18 0.12 0.002</size></box></geometry>
          <material><ambient>0.9 0.7 0.05 1</ambient><diffuse>0.95 0.75 0.05 1</diffuse></material>
        </visual>
        <visual name="pad_ring_w">
          <pose>0 -1.15 0.006 0 0 0</pose>
          <geometry><box><size>2.18 0.12 0.002</size></box></geometry>
          <material><ambient>0.9 0.7 0.05 1</ambient><diffuse>0.95 0.75 0.05 1</diffuse></material>
        </visual>
        <visual name="pad_h_left">
          <pose>0 0.35 0.006 0 0 0</pose>
          <geometry><box><size>1.1 0.16 0.002</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="pad_h_right">
          <pose>0 -0.35 0.006 0 0 0</pose>
          <geometry><box><size>1.1 0.16 0.002</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="pad_h_cross">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry><box><size>0.18 0.7 0.002</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING A (NE, x=10..20, y=5..15): Collapsed 3-story Office Block
         ================================================================ -->
    <model name="collapsed_building_a">
      <static>true</static>
      <link name="structure">
        <!-- Intact North-East back wall -->
        <collision name="wall_n_col"><pose>15 15 3.5 0 0 0</pose><geometry><box><size>10 0.4 7.0</size></box></geometry></collision>
        <visual name="wall_n_vis">
          <pose>15 15 3.5 0 0 0</pose><geometry><box><size>10 0.4 7.0</size></box></geometry>
          <material><ambient>0.46 0.44 0.41 1</ambient><diffuse>0.54 0.51 0.48 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- East sheared wall -->
        <collision name="wall_e_col"><pose>20 10 2.8 0 0 0</pose><geometry><box><size>0.4 10 5.6</size></box></geometry></collision>
        <visual name="wall_e_vis">
          <pose>20 10 2.8 0 0 0</pose><geometry><box><size>0.4 10 5.6</size></box></geometry>
          <material><ambient>0.42 0.40 0.38 1</ambient><diffuse>0.50 0.48 0.45 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- Fractured West wall segment -->
        <collision name="wall_w_col"><pose>10 11.5 2.0 0 0.08 0</pose><geometry><box><size>0.4 6.5 4.0</size></box></geometry></collision>
        <visual name="wall_w_vis">
          <pose>10 11.5 2.0 0 0.08 0</pose><geometry><box><size>0.4 6.5 4.0</size></box></geometry>
          <material><ambient>0.48 0.45 0.42 1</ambient><diffuse>0.56 0.53 0.50 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- Collapsed South facade base (victim_2 sits near y=5.4, x=11.8) -->
        <collision name="wall_s_base_col"><pose>15.5 6.8 0.9 0.12 0 0</pose><geometry><box><size>7.5 0.45 1.8</size></box></geometry></collision>
        <visual name="wall_s_base_vis">
          <pose>15.5 6.8 0.9 0.12 0 0</pose><geometry><box><size>7.5 0.45 1.8</size></box></geometry>
          <material><ambient>0.44 0.42 0.39 1</ambient><diffuse>0.52 0.50 0.46 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- Massive tilted collapsed roof slab -->
        <collision name="tilted_roof_col"><pose>15.2 10.5 3.1 0.46 0.10 0</pose><geometry><box><size>9.4 9.0 0.35</size></box></geometry></collision>
        <visual name="tilted_roof_vis">
          <pose>15.2 10.5 3.1 0.46 0.10 0</pose><geometry><box><size>9.4 9.0 0.35</size></box></geometry>
          <material><ambient>0.38 0.36 0.35 1</ambient><diffuse>0.46 0.44 0.42 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.65</temperature></plugin>
        </visual>

        <!-- Collapsed 2nd floor mid-slab -->
        <collision name="mid_slab_col"><pose>14.8 11.2 1.6 0.28 -0.06 0</pose><geometry><box><size>8.5 6.8 0.28</size></box></geometry></collision>
        <visual name="mid_slab_vis">
          <pose>14.8 11.2 1.6 0.28 -0.06 0</pose><geometry><box><size>8.5 6.8 0.28</size></box></geometry>
          <material><ambient>0.40 0.39 0.37 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>

        <!-- Fallen corner column + steel I-beam -->
        <collision name="fallen_col_a"><pose>10.5 6.2 0.45 0.2 1.25 0.3</pose><geometry><box><size>0.45 0.45 4.2</size></box></geometry></collision>
        <visual name="fallen_col_a_vis">
          <pose>10.5 6.2 0.45 0.2 1.25 0.3</pose><geometry><box><size>0.45 0.45 4.2</size></box></geometry>
          <material><ambient>0.45 0.44 0.42 1</ambient><diffuse>0.52 0.51 0.48 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>290.65</temperature></plugin>
        </visual>
        <visual name="rebar_beam_a">
          <pose>12.5 5.2 1.1 0.4 0.8 0.2</pose><geometry><box><size>0.12 0.12 3.8</size></box></geometry>
          <material><ambient>0.28 0.18 0.12 1</ambient><diffuse>0.36 0.22 0.15 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING B (NW, x=8..18, y=-15..-5): Damaged Brick/Concrete Block
         ================================================================ -->
    <model name="collapsed_building_b">
      <static>true</static>
      <link name="structure">
        <!-- South back wall -->
        <collision name="b_wall_s_col"><pose>13 -15 3.2 0 0 0</pose><geometry><box><size>10 0.4 6.4</size></box></geometry></collision>
