    <!-- ================================================================
         SOUTH / WEST RUINS & FALLEN STREET INFRASTRUCTURE
         ================================================================ -->
    <model name="south_ruins">
      <static>true</static>
      <link name="ruins">
        <!-- Crumbled boundary wall near victim_5 (-5.0, 7.2) -->
        <collision name="s_wall_1_col"><pose>-6.2 8.8 1.3 0 0 0.25</pose><geometry><box><size>5.5 0.4 2.6</size></box></geometry></collision>
