        <visual name="b_roof_vis">
          <pose>13.0 -12.0 3.2 -0.32 0.12 0</pose><geometry><box><size>9.0 6.5 0.32</size></box></geometry>
          <material><ambient>0.36 0.35 0.34 1</ambient><diffuse>0.44 0.43 0.41 1</diffuse></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>291.15</temperature></plugin>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BUILDING C (East, x=21..32, y=-6..6): Pancaked Multi-Slab Structure
         ================================================================ -->
    <model name="collapsed_building_c">
      <static>true</static>
      <link name="structure">
        <!-- Lower slab (victim_4 rests near 21.5, -1.0, z=0.85 on west slope) -->
        <collision name="c_slab_1_col"><pose>24.5 0 0.65 0 -0.18 0</pose><geometry><box><size>8.5 9.5 0.34</size></box></geometry></collision>
