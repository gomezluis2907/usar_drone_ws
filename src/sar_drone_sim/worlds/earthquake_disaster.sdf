          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>292.15</temperature></plugin>
        </visual>
        <visual name="car_cabin_vis">
          <pose>-0.25 0 0.62 0 0 0</pose>
