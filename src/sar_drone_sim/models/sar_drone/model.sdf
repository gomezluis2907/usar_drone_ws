<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sar_drone">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.045</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.045</iyy>
          <iyz>0</iyz>
          <izz>0.080</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.42 0.42 0.19</size>
          </box>
        </geometry>
      </collision>

      <!-- Main carbon-fiber body -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26 0.16 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298.15</temperature>
        </plugin>
      </visual>

      <!-- High-visibility SAR orange top shell -->
      <visual name="top_shell_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298.15</temperature>
        </plugin>
      </visual>

      <!-- Forward indicator LED bar (+X) -->
      <visual name="front_led_visual">
        <pose>0.132 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.09 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.9 0.2 1</ambient>
          <diffuse>0.1 0.95 0.25 1</diffuse>
          <emissive>0.1 0.8 0.2 1</emissive>
        </material>
      </visual>

      <!-- 4 Diagonal carbon arms -->
      <visual name="arm_0_visual">
        <pose>0.09 -0.09 0.01 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_1_visual">
        <pose>-0.09 0.09 0.01 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_2_visual">
        <pose>0.09 0.09 0.01 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_3_visual">
        <pose>-0.09 -0.09 0.01 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>

      <!-- Landing skids (bottom at z = -0.105) -->
      <visual name="skid_left_visual">
        <pose>0 0.11 -0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_right_visual">
        <pose>0 -0.11 -0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_fl">
        <pose>0.07 0.095 -0.06 0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_rl">
        <pose>-0.07 0.095 -0.06 0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_fr">
        <pose>0.07 -0.095 -0.06 -0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_rr">
        <pose>-0.07 -0.095 -0.06 -0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Front gimbal / camera payload housing -->
      <visual name="gimbal_visual">
        <pose>0.14 0 -0.025 0 0.48 0</pose>
        <geometry>
          <box>
            <size>0.045 0.065 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1</ambient>
          <diffuse>0.12 0.12 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Thermal camera sensor (angled down 27.5 deg for forward+ground scanning) -->
      <sensor name="thermal_camera" type="thermal">
        <pose>0.165 0 -0.03 0 0.48 0</pose>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L16</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/sar_drone/thermal/image_raw</topic>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>273.15</min_temp>
          <max_temp>373.15</max_temp>
          <resolution>0.01</resolution>
        </plugin>
      </sensor>

      <!-- Co-located RGB camera for operator visual reference -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.165 0 -0.03 0 0.48 0</pose>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/sar_drone/rgb/image_raw</topic>
      </sensor>
    </link>

    <!-- Rotor 0: Front-Right (CCW) -->
    <link name="rotor_0">
      <pose>0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 1: Rear-Left (CCW) -->
    <link name="rotor_1">
      <pose>-0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <child>rotor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 2: Front-Left (CW) -->
    <link name="rotor_2">
      <pose>0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <child>rotor_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 3: Rear-Right (CW) -->
    <link name="rotor_3">
      <pose>-0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <child>rotor_3</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Multicopter motor plugins -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Multicopter Velocity Controller (/cmd_vel) -->
    <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>sar_drone</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2 3 0.15</attitudeGain>
      <angularRateGain>0.4 0.52 0.18</angularRateGain>
      <maximumLinearAcceleration>2.5 2.5 2.5</maximumLinearAcceleration>
      <maximumLinearVelocity>6 6 4</maximumLinearVelocity>
      <maximumAngularVelocity>3 3 2</maximumAngularVelocity>
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

    <!-- 3D Odometry Publisher -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/sar_drone/odometry</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>sar_drone/base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
