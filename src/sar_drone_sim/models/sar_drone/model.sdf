<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sar_drone">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.045</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.045</iyy>
          <iyz>0</iyz>
          <izz>0.080</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.56 0.56 0.19</size>
          </box>
        </geometry>
      </collision>

      <!-- Main carbon-fiber body -->
      <visual name="chassis_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26 0.16 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.18 0.18 0.20 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298.15</temperature>
        </plugin>
      </visual>

      <!-- High-visibility SAR orange top shell -->
      <visual name="top_shell_visual">
        <pose>0 0 0.045 0 0 0</pose>
        <geometry>
          <box>
            <size>0.18 0.12 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
        <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
          <temperature>298.15</temperature>
        </plugin>
      </visual>

      <!-- Forward indicator LED bar (+X) -->
      <visual name="front_led_visual">
        <pose>0.132 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.09 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.9 0.2 1</ambient>
          <diffuse>0.1 0.95 0.25 1</diffuse>
          <emissive>0.1 0.8 0.2 1</emissive>
        </material>
      </visual>

      <!-- 4 Diagonal carbon arms -->
      <visual name="arm_0_visual">
        <pose>0.09 -0.09 0.01 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_1_visual">
        <pose>-0.09 0.09 0.01 0 0 -0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_2_visual">
        <pose>0.09 0.09 0.01 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>
      <visual name="arm_3_visual">
        <pose>-0.09 -0.09 0.01 0 0 0.785398</pose>
        <geometry>
          <box>
            <size>0.27 0.024 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.17 1</ambient>
          <diffuse>0.2 0.2 0.22 1</diffuse>
        </material>
      </visual>

      <!-- Landing skids (bottom at z = -0.105) -->
      <visual name="skid_left_visual">
        <pose>0 0.11 -0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_right_visual">
        <pose>0 -0.11 -0.095 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.02 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_fl">
        <pose>0.07 0.095 -0.06 0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_rl">
        <pose>-0.07 0.095 -0.06 0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_fr">
        <pose>0.07 -0.095 -0.06 -0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name="skid_strut_rr">
        <pose>-0.07 -0.095 -0.06 -0.25 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.016 0.065</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Position & strobe navigation lights (C14) -->
      <visual name="nav_light_port">
        <pose>0.21 0.21 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.014</radius></sphere></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1.0 0.15 0.15 1</diffuse><emissive>0.95 0.1 0.1 1</emissive></material>
      </visual>
      <visual name="nav_light_starboard">
        <pose>0.21 -0.21 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.014</radius></sphere></geometry>
        <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.15 1.0 0.25 1</diffuse><emissive>0.1 0.95 0.2 1</emissive></material>
      </visual>
      <visual name="nav_light_rear_l">
        <pose>-0.21 0.21 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><emissive>0.95 0.95 0.95 1</emissive></material>
      </visual>
      <visual name="nav_light_rear_r">
        <pose>-0.21 -0.21 0.055 0 0 0</pose>
        <geometry><sphere><radius>0.012</radius></sphere></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse><emissive>0.95 0.95 0.95 1</emissive></material>
      </visual>
      <visual name="top_strobe_beacon">
        <pose>0 0 0.072 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>1.0 0.7 0.1 1</ambient><diffuse>1.0 0.8 0.2 1</diffuse><emissive>1.0 0.65 0.05 1</emissive></material>
      </visual>

      <!-- Octagonal Propeller Guards (C12) -->
      <!-- Front-Right Guard (rotor_0: 0.18, -0.18) -->
      <visual name="pg0_0"><pose>0.315 -0.180 0.04 0 0 1.5708</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_1"><pose>0.275 -0.085 0.04 0 0 2.3562</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_2"><pose>0.180 -0.045 0.04 0 0 3.1416</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_3"><pose>0.085 -0.085 0.04 0 0 3.9270</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_4"><pose>0.045 -0.180 0.04 0 0 4.7124</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_5"><pose>0.085 -0.275 0.04 0 0 5.4978</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_6"><pose>0.180 -0.315 0.04 0 0 0.0000</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg0_7"><pose>0.275 -0.275 0.04 0 0 0.7854</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>

      <!-- Front-Left Guard (rotor_2: 0.18, 0.18) -->
      <visual name="pg2_0"><pose>0.315 0.180 0.04 0 0 1.5708</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_1"><pose>0.275 0.275 0.04 0 0 2.3562</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_2"><pose>0.180 0.315 0.04 0 0 3.1416</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_3"><pose>0.085 0.275 0.04 0 0 3.9270</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_4"><pose>0.045 0.180 0.04 0 0 4.7124</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_5"><pose>0.085 0.085 0.04 0 0 5.4978</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_6"><pose>0.180 0.045 0.04 0 0 0.0000</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>
      <visual name="pg2_7"><pose>0.275 0.085 0.04 0 0 0.7854</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.85 0.32 0.04 1</ambient><diffuse>0.95 0.38 0.04 1</diffuse></material></visual>

      <!-- Rear-Left Guard (rotor_1: -0.18, 0.18) -->
      <visual name="pg1_0"><pose>-0.045 0.180 0.04 0 0 1.5708</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_1"><pose>-0.085 0.275 0.04 0 0 2.3562</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_2"><pose>-0.180 0.315 0.04 0 0 3.1416</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_3"><pose>-0.275 0.275 0.04 0 0 3.9270</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_4"><pose>-0.315 0.180 0.04 0 0 4.7124</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_5"><pose>-0.275 0.085 0.04 0 0 5.4978</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_6"><pose>-0.180 0.045 0.04 0 0 0.0000</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg1_7"><pose>-0.085 0.085 0.04 0 0 0.7854</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>

      <!-- Rear-Right Guard (rotor_3: -0.18, -0.18) -->
      <visual name="pg3_0"><pose>-0.045 -0.180 0.04 0 0 1.5708</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_1"><pose>-0.085 -0.085 0.04 0 0 2.3562</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_2"><pose>-0.180 -0.045 0.04 0 0 3.1416</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_3"><pose>-0.275 -0.085 0.04 0 0 3.9270</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_4"><pose>-0.315 -0.180 0.04 0 0 4.7124</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_5"><pose>-0.275 -0.275 0.04 0 0 5.4978</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_6"><pose>-0.180 -0.315 0.04 0 0 0.0000</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="pg3_7"><pose>-0.085 -0.275 0.04 0 0 0.7854</pose><geometry><box><size>0.112 0.012 0.025</size></box></geometry><material><ambient>0.16 0.17 0.19 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>

      <!-- Dedicated Pilot FPV Navigation Camera (C07) -->
      <sensor name="fpv_camera" type="camera">
        <pose>0.145 0 0.015 0 0.12 0</pose>
        <camera>
          <horizontal_fov>1.45</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <topic>/sar_drone/fpv/image_raw</topic>
      </sensor>
    </link>

    <!-- Motorized Pitch Gimbal Link for Bi-Spectral Payload (C02, C08) -->
    <link name="gimbal_link">
      <pose>0.14 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-5</iyy>
          <iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>

      <visual name="gimbal_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.045 0.065 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1</ambient>
          <diffuse>0.12 0.12 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Thermal camera sensor -->
      <sensor name="thermal_camera" type="thermal">
        <pose>0.025 0 -0.005 0 0 0</pose>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L16</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>80</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>true</visualize>
        <topic>/sar_drone/thermal/image_raw</topic>
        <plugin filename="gz-sim-thermal-sensor-system" name="gz::sim::systems::ThermalSensor">
          <min_temp>273.15</min_temp>
          <max_temp>373.15</max_temp>
          <resolution>0.01</resolution>
        </plugin>
      </sensor>

      <!-- Co-located RGB camera for observer visual reference -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.025 0 -0.005 0 0 0</pose>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/sar_drone/rgb/image_raw</topic>
      </sensor>
    </link>

    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>base_link</parent>
      <child>gimbal_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.45</upper>
          <effort>2.0</effort>
          <velocity>3.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- Rotor 0: Front-Right (CCW) -->
    <link name="rotor_0">
      <pose>0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 1: Rear-Left (CCW) -->
    <link name="rotor_1">
      <pose>-0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <child>rotor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 2: Front-Left (CW) -->
    <link name="rotor_2">
      <pose>0.18 0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.35 0.02 1</ambient>
          <diffuse>0.95 0.38 0.04 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <child>rotor_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Rotor 3: Rear-Right (CW) -->
    <link name="rotor_3">
      <pose>-0.18 -0.18 0.04 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>9.75e-07</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.17041e-05</iyy>
          <iyz>0</iyz>
          <izz>4.26041e-05</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <box>
            <size>0.22 0.022 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <child>rotor_3</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Multicopter motor plugins -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>0</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>1</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>2</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>sar_drone</robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1100.0</maxRotVelocity>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <actuator_number>3</actuator_number>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Multicopter Velocity Controller (/cmd_vel) -->
    <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>sar_drone</robotNamespace>
      <commandSubTopic>gazebo/command/twist</commandSubTopic>
      <enableSubTopic>enable</enableSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>2.7 2.7 2.7</velocityGain>
      <attitudeGain>2 3 0.15</attitudeGain>
      <angularRateGain>0.4 0.52 0.18</angularRateGain>
      <maximumLinearAcceleration>2.5 2.5 2.5</maximumLinearAcceleration>
      <maximumLinearVelocity>6 6 4</maximumLinearVelocity>
      <maximumAngularVelocity>3 3 2</maximumAngularVelocity>
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>8.54858e-06</forceConstant>
          <momentConstant>0.016</momentConstant>
          <direction>-1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>

    <!-- Gimbal Pitch Position Controller -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_pitch_joint</joint_name>
      <topic>/sar_drone/gimbal/pitch_cmd</topic>
      <initial_position>0.48</initial_position>
      <p_gain>1.5</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.12</d_gain>
      <cmd_min>-0.5</cmd_min>
      <cmd_max>0.5</cmd_max>
    </plugin>

    <!-- 3D Odometry Publisher -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/sar_drone/odometry</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>sar_drone/base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
