Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 40
      Cell Size: 2
      Color: 90; 100; 110
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Drone Odometry
      Topic:
        Value: /sar_drone/odom
      Keep: 120
      Shape:
        Value: Arrow
        Color: 40; 220; 90
        Shaft Length: 0.6
        Shaft Radius: 0.08
        Head Length: 0.3
        Head Radius: 0.16
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Victim Markers
      Topic:
        Value: /sar_drone/victim_markers
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: GCS Tactical HUD
      Topic:
        Value: /sar_drone/gcs/image
  Enabled: true
  Global Options:
    Background Color: 26; 30; 36
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 36
      Focal Point:
        X: 10
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.72
      Yaw: 0.45
Window Geometry:
  Height: 820
  Width: 1280
